[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/SystemMenu.gd" id="1"]
[ext_resource type="Theme"  path="res://themes/ui_theme.tres" id="2"]

; Menú de sistema in-game. La raíz ignora el ratón (mouse_filter=2) para no
; bloquear el juego; solo el botón y el overlay capturan clics.

[node name="SystemMenu" type="Control"]
offset_right = 1280.0
offset_bottom = 720.0
mouse_filter = 2
theme = ExtResource("2")
script = ExtResource("1")

[node name="OpenButton" type="Button" parent="."]
offset_left = 20.0
offset_top = 18.0
offset_right = 128.0
offset_bottom = 58.0
theme_override_font_sizes/font_size = 16
text = "☰  Menú"

; ── Overlay del menú (oculto por defecto) ─────────────────────────────────────
[node name="Overlay" type="Control" parent="."]
visible = false
offset_right = 1280.0
offset_bottom = 720.0
mouse_filter = 2

[node name="Dim" type="ColorRect" parent="Overlay"]
offset_right = 1280.0
offset_bottom = 720.0
color = Color(0.03, 0.03, 0.06, 0.82)

[node name="Panel" type="Panel" parent="Overlay"]
offset_left = 440.0
offset_top = 200.0
offset_right = 840.0
offset_bottom = 520.0

[node name="Title" type="Label" parent="Overlay/Panel"]
offset_left = 24.0
offset_top = 22.0
offset_right = 376.0
offset_bottom = 60.0
horizontal_alignment = 1
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color = Color(0.82, 0.78, 0.98, 1)
text = "Menú"

[node name="VBox" type="VBoxContainer" parent="Overlay/Panel"]
offset_left = 40.0
offset_top = 76.0
offset_right = 360.0
offset_bottom = 296.0
theme_override_constants/separation = 12

[node name="ResumeButton" type="Button" parent="Overlay/Panel/VBox"]
custom_minimum_size = Vector2(0, 46)
size_flags_horizontal = 3
text = "Continuar"

[node name="SaveButton" type="Button" parent="Overlay/Panel/VBox"]
custom_minimum_size = Vector2(0, 46)
size_flags_horizontal = 3
text = "Guardar partida"

[node name="LoadButton" type="Button" parent="Overlay/Panel/VBox"]
custom_minimum_size = Vector2(0, 46)
size_flags_horizontal = 3
text = "Cargar partida"

[node name="MenuButton" type="Button" parent="Overlay/Panel/VBox"]
custom_minimum_size = Vector2(0, 46)
size_flags_horizontal = 3
text = "Ir al menú principal"

[connection signal="pressed" from="OpenButton" to="." method="_on_open_pressed"]
[connection signal="pressed" from="Overlay/Panel/VBox/ResumeButton" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="Overlay/Panel/VBox/SaveButton" to="." method="_on_save_pressed"]
[connection signal="pressed" from="Overlay/Panel/VBox/LoadButton" to="." method="_on_load_pressed"]
[connection signal="pressed" from="Overlay/Panel/VBox/MenuButton" to="." method="_on_menu_pressed"]
