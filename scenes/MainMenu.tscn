[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/MainMenu.gd" id="1"]

[node name="MainMenu" type="Node2D"]
script = ExtResource("1")

[node name="UILayer" type="CanvasLayer" parent="."]
layer = 1

; ── Fondo sólido oscuro ───────────────────────────────────────────────────────
[node name="BackgroundColor" type="ColorRect" parent="UILayer"]
offset_right  = 1280.0
offset_bottom = 720.0
color         = Color(0.06, 0.06, 0.12, 1.0)
mouse_filter  = 2

; ── Título del juego ───────────────────────────────────────────────────────────
[node name="TitleLabel" type="Label" parent="UILayer"]
offset_left   = 100.0
offset_top    = 155.0
offset_right  = 1180.0
offset_bottom = 255.0
horizontal_alignment = 1
theme_override_font_sizes/font_size = 58
text = "VISUAL NOVEL"

[node name="SubtitleLabel" type="Label" parent="UILayer"]
offset_left   = 100.0
offset_top    = 262.0
offset_right  = 1180.0
offset_bottom = 300.0
horizontal_alignment = 1
theme_override_font_sizes/font_size = 18
text = "Una historia de decisiones"

; ── Botones del menú ──────────────────────────────────────────────────────────
[node name="ButtonContainer" type="VBoxContainer" parent="UILayer"]
offset_left   = 490.0
offset_top    = 350.0
offset_right  = 790.0
offset_bottom = 490.0
theme_override_constants/separation = 14

[node name="StartButton" type="Button" parent="UILayer/ButtonContainer"]
size_flags_horizontal = 3
custom_minimum_size   = Vector2(0, 55)
theme_override_font_sizes/font_size = 18
text = "Inicio"

[node name="CreditsButton" type="Button" parent="UILayer/ButtonContainer"]
size_flags_horizontal = 3
custom_minimum_size   = Vector2(0, 55)
theme_override_font_sizes/font_size = 18
text = "Créditos"

; ── Panel de créditos (oculto por defecto) ────────────────────────────────────
[node name="CreditsPanel" type="Panel" parent="UILayer"]
visible       = false
offset_left   = 290.0
offset_top    = 140.0
offset_right  = 990.0
offset_bottom = 578.0

[node name="CreditsTitle" type="Label" parent="UILayer/CreditsPanel"]
offset_left   = 20.0
offset_top    = 16.0
offset_right  = 680.0
offset_bottom = 54.0
horizontal_alignment = 1
theme_override_font_sizes/font_size = 22
text = "Créditos"

[node name="CreditsText" type="Label" parent="UILayer/CreditsPanel"]
offset_left   = 30.0
offset_top    = 62.0
