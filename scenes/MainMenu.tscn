[node name="CloseButton" type="Button" parent="UILayer/CreditsPanel"]
offset_left   = 248.0
offset_top    = 390.0
offset_right  = 452.0
offset_bottom = 432.0
size_flags_horizontal = 3
text = "Cerrar"

; ── FadeOverlay — encima de todo, bloquea input durante transiciones ──────────
; mouse_filter=0 (STOP) para bloquear clicks mientras el fade está activo.
; MainMenu.gd lo pone en mouse_filter=2 (IGNORE) cuando alpha llega a 0.
[node name="FadeOverlay" type="ColorRect" parent="UILayer"]
offset_right  = 1280.0
offset_bottom = 720.0
color         = Color(0, 0, 0, 1)
mouse_filter  = 0

; ── Conexiones ────────────────────────────────────────────────────────────────
[connection signal="pressed" from="UILayer/ButtonContainer/StartButton"   to="." method="_on_start_pressed"]
[connection signal="pressed" from="UILayer/ButtonContainer/CreditsButton" to="." method="_on_credits_pressed"]
[connection signal="pressed" from="UILayer/CreditsPanel/CloseButton"      to="." method="_on_close_credits_pressed"]
