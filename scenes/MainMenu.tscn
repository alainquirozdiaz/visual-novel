custom_minimum_size   = Vector2(0, 56)
text = "▶  Inicio"

[node name="CreditsButton" type="Button" parent="UILayer/ButtonContainer"]
size_flags_horizontal = 3
custom_minimum_size   = Vector2(0, 56)
text = "★  Créditos"

; ── Créditos: overlay a pantalla completa (oculto por defecto) ─────────────────
; CreditsRoot cubre toda la pantalla; el Dim tapa el menú y bloquea clics.
[node name="CreditsRoot" type="Control" parent="UILayer"]
visible       = false
offset_right  = 1280.0
offset_bottom = 720.0
theme         = ExtResource("2")

[node name="Dim" type="ColorRect" parent="UILayer/CreditsRoot"]
offset_right  = 1280.0
offset_bottom = 720.0
color         = Color(0.04, 0.04, 0.08, 0.94)

[node name="Panel" type="Panel" parent="UILayer/CreditsRoot"]
