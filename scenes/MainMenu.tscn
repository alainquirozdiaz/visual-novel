offset_bottom = 720.0
color         = Color(0.05, 0.05, 0.1, 1.0)
mouse_filter  = 2

[node name="BackgroundGlow" type="ColorRect" parent="UILayer"]
offset_left   = 240.0
offset_top    = 120.0
offset_right  = 1040.0
offset_bottom = 600.0
color         = Color(0.16, 0.13, 0.28, 0.35)
mouse_filter  = 2

; ── Título del juego ───────────────────────────────────────────────────────────
[node name="TitleLabel" type="Label" parent="UILayer"]
offset_left   = 100.0
offset_top    = 150.0
offset_right  = 1180.0
offset_bottom = 250.0
horizontal_alignment = 1
theme_override_font_sizes/font_size = 66
theme_override_colors/font_color = Color(0.95, 0.94, 1, 1)
