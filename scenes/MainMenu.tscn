; ── Botones del menú ──────────────────────────────────────────────────────────
[node name="ButtonContainer" type="VBoxContainer" parent="UILayer"]
offset_left   = 500.0
offset_top    = 360.0
offset_right  = 780.0
offset_bottom = 520.0
theme         = ExtResource("2")
theme_override_constants/separation = 18

[node name="StartButton" type="Button" parent="UILayer/ButtonContainer"]
