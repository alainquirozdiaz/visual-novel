[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/SaveSlotPanel.gd" id="1"]
[ext_resource type="Theme"  path="res://themes/ui_theme.tres"    id="2"]

; Overlay a pantalla completa para elegir ranura de guardado/carga.
; Se instancia en UILayer (juego) y en MainMenu (cargar desde el inicio).

[node name="SaveSlotPanel" type="Control"]
visible = false
offset_right = 1280.0
offset_bottom = 720.0
mouse_filter = 2
theme = ExtResource("2")
script = ExtResource("1")

[node name="Dim" type="ColorRect" parent="."]
offset_right = 1280.0
offset_bottom = 720.0
color = Color(0.03, 0.03, 0.06, 0.9)

[node name="Panel" type="Panel" parent="."]
offset_left = 360.0
offset_top = 60.0
offset_right = 920.0
offset_bottom = 660.0

[node name="Title" type="Label" parent="Panel"]
offset_left = 30.0
offset_top = 24.0
offset_right = 530.0
offset_bottom = 66.0
horizontal_alignment = 1
theme_override_font_sizes/font_size = 26
theme_override_colors/font_color = Color(0.82, 0.78, 0.98, 1)
text = "Guardar partida"

[node name="SlotList" type="VBoxContainer" parent="Panel"]
offset_left = 30.0
offset_top = 86.0
offset_right = 530.0
offset_bottom = 512.0
theme_override_constants/separation = 8

[node name="CloseButton" type="Button" parent="Panel"]
offset_left = 180.0
offset_top = 526.0
offset_right = 380.0
offset_bottom = 572.0
size_flags_horizontal = 3
text = "Cerrar"

; Diálogo de confirmación para eliminar una ranura.
[node name="ConfirmDelete" type="ConfirmationDialog" parent="."]
title = "Eliminar guardado"
ok_button_text = "Eliminar"
cancel_button_text = "Cancelar"
dialog_text = "¿Eliminar este guardado?"

[connection signal="pressed" from="Panel/CloseButton" to="." method="_on_close_pressed"]
