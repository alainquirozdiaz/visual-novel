[gd_scene load_steps=7 format=3]

[ext_resource type="Script"      path="res://scripts/Main.gd"              id="1"]
[ext_resource type="Script"      path="res://scripts/CharacterAnimator.gd" id="2"]
[ext_resource type="Script"      path="res://scripts/DialogueManager.gd"   id="3"]
[ext_resource type="Script"      path="res://scripts/TypewriterManager.gd" id="4"]
[ext_resource type="PackedScene" path="res://scenes/CharacterSprite.tscn"  id="5"]
[ext_resource type="PackedScene" path="res://scenes/UILayer.tscn"          id="6"]

; ── Raíz ──────────────────────────────────────────────────────────────────────
[node name="Main" type="Node2D"]
script = ExtResource("1")

; ── Fondo full-screen ──────────────────────────────────────────────────────────
[node name="Background" type="TextureRect" parent="."]
offset_right  = 1280.0
offset_bottom = 720.0
expand_mode   = 1
stretch_mode  = 6

; ── Sprites de personajes (instancias de CharacterSprite.tscn) ────────────────
[node name="SpriteLeft" parent="." instance=ExtResource("5")]
offset_left   = 0.0
offset_top    = 50.0
offset_right  = 400.0
offset_bottom = 650.0

[node name="SpriteRight" parent="." instance=ExtResource("5")]
offset_left   = 880.0
offset_top    = 50.0
offset_right  = 1280.0
offset_bottom = 650.0

; ── Managers lógicos ──────────────────────────────────────────────────────────
[node name="CharacterAnimator" type="Node" parent="."]
script = ExtResource("2")

[node name="DialogueManager" type="Node" parent="."]
script = ExtResource("3")

[node name="TypewriterManager" type="Node" parent="."]
script = ExtResource("4")

[node name="TypewriterTimer" type="Timer" parent="."]
wait_time = 0.03

; ── UI completa (instancia de UILayer.tscn) ───────────────────────────────────
; El nombre "UIManager" es el que espera Main.gd en sus @onready vars.
[node name="UIManager" parent="." instance=ExtResource("6")]
