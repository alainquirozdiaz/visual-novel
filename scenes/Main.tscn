[gd_scene load_steps=10 format=3]

[ext_resource type="Script"      path="res://scripts/Main.gd"              id="1"]
[ext_resource type="Script"      path="res://scripts/CharacterAnimator.gd" id="2"]
[ext_resource type="Script"      path="res://scripts/DialogueManager.gd"   id="3"]
[ext_resource type="Script"      path="res://scripts/TypewriterManager.gd" id="4"]
[ext_resource type="PackedScene" path="res://scenes/CharacterSprite.tscn"  id="5"]
[ext_resource type="PackedScene" path="res://scenes/UILayer.tscn"          id="6"]
[ext_resource type="Shader"      path="res://shaders/blur.gdshader"        id="7"]
[ext_resource type="PackedScene" path="res://scenes/EndScreen.tscn"        id="8"]

; ShaderMaterial embebida — blur_strength empieza en 6.0 y se anima a 0.0 en _play_intro().
[sub_resource type="ShaderMaterial" id="ShaderMat_bg"]
shader = ExtResource("7")
shader_parameter/blur_strength = 6.0

; ── Raíz ──────────────────────────────────────────────────────────────────────
[node name="Main" type="Node2D"]
script = ExtResource("1")

; ── Fondo full-screen con blur inicial ────────────────────────────────────────
[node name="Background" type="TextureRect" parent="."]
material      = SubResource("ShaderMat_bg")
offset_right  = 1280.0
offset_bottom = 720.0
expand_mode   = 1
stretch_mode  = 6

; ── Sprites de personajes ─────────────────────────────────────────────────────
[node name="SpriteLeft" parent="." instance=ExtResource("5")]
offset_left   = 0.0
offset_top    = 50.0
offset_right  = 400.0
offset_bottom = 650.0

[node name="SpriteRight" parent="." instance=ExtResource("5")]
offset_left   = 880.0
offset_top    = 50.0
offset_right  = 1280.0
offset_bottom = 650.0

; ── Managers lógicos ──────────────────────────────────────────────────────────
[node name="CharacterAnimator" type="Node" parent="."]
script = ExtResource("2")

[node name="DialogueManager" type="Node" parent="."]
script = ExtResource("3")

[node name="TypewriterManager" type="Node" parent="."]
script = ExtResource("4")

[node name="TypewriterTimer" type="Timer" parent="."]
wait_time = 0.03

; ── UI (layer=1) ──────────────────────────────────────────────────────────────
[node name="UIManager" parent="." instance=ExtResource("6")]

; ── Capa de transición (layer=10, siempre encima de todo) ─────────────────────
[node name="TransitionLayer" type="CanvasLayer" parent="."]
layer = 10

[node name="FadeOverlay" type="ColorRect" parent="TransitionLayer"]
offset_right  = 1280.0
offset_bottom = 720.0
color         = Color(0, 0, 0, 1)
mouse_filter  = 2

; ── Pantalla de cierre (layer=5) ──────────────────────────────────────────────
[node name="EndScreen" parent="." instance=ExtResource("8")]
